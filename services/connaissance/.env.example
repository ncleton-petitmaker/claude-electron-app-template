# Public service URL, for example https://connaissance.example.com
NEXT_PUBLIC_CONNAISSANCE_SERVICE_URL=

# Bridge Control Plane URL, for example https://admin.example.com
BRIDGE_CONTROL_PLANE_URL=
NEXT_PUBLIC_BRIDGE_SERVICE_ID=knowledge_ai

# Dedicated Supabase project for this service.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Local-only AI policy. Do not configure external AI provider keys here.
KNOWLEDGE_AI_PROVIDER_MODE=local_only
KNOWLEDGE_AI_LMSTUDIO_BASE_URL=http://127.0.0.1:1234/v1
KNOWLEDGE_AI_DGX_ENABLED=0
KNOWLEDGE_AI_DGX_BASE_URL=
